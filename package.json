{
  "name": "firebase-mcp-server",
  "version": "0.0.0-development",
  "description": "MCP Server for Google Firebase (Auth, Firestore & Storage) with dynamic credential loading",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "firebase-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "firebase",
    "firestore",
    "firebase-auth",
    "firebase-storage",
    "auth",
    "storage",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoblerS/firestore-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/KoblerS/firestore-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "firebase-admin": "^14.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  }
}
