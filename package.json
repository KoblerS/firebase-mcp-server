{
  "name": "firebase-mcp-server",
  "version": "0.0.0-development",
  "description": "MCP Server for Google Firebase (Auth, Firestore & Storage) with dynamic credential loading",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "firebase-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "firebase",
    "firestore",
    "firebase-auth",
    "firebase-storage",
    "auth",
    "storage",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoblerS/firebase-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/KoblerS/firebase-mcp-server/issues"
  },
  "homepage": "https://github.com/KoblerS/firebase-mcp-server#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google-cloud/functions": "^5.1.0",
    "@google-cloud/logging": "^12.1.0",
    "@google-cloud/scheduler": "^6.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "firebase-admin": "^14.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
